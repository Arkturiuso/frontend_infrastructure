  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/gh-pages": "6.1.0",
    "@types/lodash": "4.17.24",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.4",
    "gh-pages": "6.3.0",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.0"
  },
  "scripts": {
    "lint": "eslint",
    "lint:all": "eslint src --fix",
    "format": "prettier --write",
    "format:all": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json}\"",
    "build": "vite build",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky install .husky",
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eslint-plugin-react": "7.37.5",
    "lodash": "4.17.23",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "packageManager": "yarn@4.10.3"
}
